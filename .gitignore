# Dependencies
node_modules/
.pnp
.pnp.js
package-lock.json  # Using Bun, not npm

# Build outputs
dist/
build/
generated/
# Where tsc-clean-build.ts has the compiler emit before promoting into dist/.
# Removed on success and on failure; only a hard kill can leave one behind.
.tsc-staging/
*.tsbuildinfo
*.tgz

# Testing
coverage/
.vitest/
.nyc_output/
**/.test-output
.test-output

# Code quality reports
jscpd-report/
.jscpd/
.eslintcache

# Environment variables and secrets
.env
.env.local
.env.*.local

# Credentials and secrets (never commit these)
credentials.json
secrets.json
secrets.yaml
secrets.yml
token.json
auth.json
*.key
*.pem
*.p12
*.pfx

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
pnpm-debug.log*
*.log
logs/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Backup files from editors/tools
*.backup

# IDE
.vscode/
.idea/

# Git worktrees
.worktrees/

# Claude Code - user-specific settings
.claude/settings.local.json
.claude/commands/
.claude/scheduled_tasks.lock
.claude/worktrees/

# Temporary files
*.tmp
*.temp
.cache/
tmp/

# Debug
.vscode-test/
*.cpuprofile
*.heapsnapshot

# Ignore ALL root-level markdown files and planning files (catches Claude Code and other AI-generated temporary files)
/*.md
docs/plans/
docs/superpowers/
.superpowers/

# Explicitly include critical documentation (negation patterns MUST come after the ignore)
!README.md
!CHANGELOG.md
!LICENSE
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!CLAUDE.md

# Misc
.turbo/
.rag-db/

# Default output dir for `vat-lab <facet> run --out`. Must stay ignored AND stay
# out of the subject tree's tracked set: the io facet counts filesystem calls, so
# lab output landing inside the project it is measuring moves the next run's
# numbers. See packages/lab/docs/roadmap.md on untracked content and the coordinate.
.vat-lab/

# Contraband token list for the adopter-name gate — must never be committed
.contraband-tokens
