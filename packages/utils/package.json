{
  "name": "@vibe-agent-toolkit/utils",
  "version": "0.1.41-rc.1",
  "type": "module",
  "description": "Core utility functions shared across the vibe-agent-toolkit packages",
  "sideEffects": false,
  "keywords": [
    "typescript",
    "utilities",
    "toolkit"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && tsx ../dev-tools/src/copy-yaml-assets.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:system": "vitest run --config vitest.system.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "ignore": "^7.0.5",
    "picomatch": "^4.0.3",
    "which": "^5.0.0",
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.2",
    "@types/which": "^3.0.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git"
  }
}
