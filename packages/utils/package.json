{
  "name": "@vibe-agent-toolkit/utils",
  "version": "0.2.0-rc.4",
  "type": "module",
  "description": "Core utility functions shared across the vibe-agent-toolkit packages",
  "sideEffects": [
    "./dist/crawl-timing.js"
  ],
  "keywords": [
    "typescript",
    "utilities",
    "toolkit",
    "cross-platform",
    "windows",
    "eslint"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./path": {
      "types": "./dist/path.d.ts",
      "import": "./dist/path.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js"
    },
    "./git": {
      "types": "./dist/git.d.ts",
      "import": "./dist/git.js"
    },
    "./glob": {
      "types": "./dist/glob.d.ts",
      "import": "./dist/glob.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    },
    "./skill-test": {
      "types": "./dist/skill-test/index.d.ts",
      "import": "./dist/skill-test/index.js"
    },
    "./yaml": {
      "types": "./dist/yaml.d.ts",
      "import": "./dist/yaml.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./asset": {
      "types": "./dist/asset.d.ts",
      "import": "./dist/asset.js"
    },
    "./crawl": {
      "types": "./dist/crawl.d.ts",
      "import": "./dist/crawl.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./eslint": {
      "types": "./eslint/index.d.cts",
      "default": "./eslint/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "eslint",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf --glob dist \"*.tsbuildinfo\" && tsc",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vibe-validate/git": "0.20.1",
    "ignore": "^7.0.5",
    "picomatch": "^4.0.3",
    "which": "^5.0.0",
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.2",
    "@types/which": "^3.0.4",
    "eslint": "^9.39.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git"
  }
}
