{
  "name": "@vibe-agent-toolkit/projection-sqlite",
  "version": "0.2.0-rc.2",
  "description": "SQLite-backed projection store for VAT, on Node's built-in node:sqlite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsx ../dev-tools/src/tsc-clean-build.ts",
    "clean": "rimraf dist *.tsbuildinfo",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sqlite",
    "projection",
    "cache",
    "resources",
    "agent-toolkit"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@vibe-agent-toolkit/resources": "workspace:*",
    "@vibe-agent-toolkit/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/projection-sqlite"
  }
}
