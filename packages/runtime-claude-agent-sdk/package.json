{
  "name": "@vibe-agent-toolkit/runtime-claude-agent-sdk",
  "version": "0.2.0-rc.2",
  "description": "Claude Agent SDK runtime adapter for VAT agents",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx ../dev-tools/src/tsc-clean-build.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.232",
    "@anthropic-ai/sdk": "^0.117.1",
    "@vibe-agent-toolkit/agent-runtime": "workspace:*",
    "@vibe-agent-toolkit/claude-marketplace": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vibe-agent-toolkit/dev-tools": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@vibe-agent-toolkit/test-agents": "workspace:*"
  },
  "keywords": [
    "ai-agent",
    "claude",
    "anthropic",
    "claude-agent-sdk",
    "vibe-agent-toolkit",
    "runtime-adapter"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
