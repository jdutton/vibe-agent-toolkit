{
  "name": "@vibe-agent-toolkit/vat-development-agents",
  "version": "0.2.0-rc.14",
  "description": "VAT's own Claude Code plugin: skills for building with vibe-agent-toolkit",
  "type": "module",
  "keywords": [
    "vat-skills",
    "claude-code-plugin",
    "skills",
    "development-tools"
  ],
  "vat": {
    "version": "1.0",
    "skills": [
      "vibe-agent-toolkit",
      "vat-adoption-and-configuration",
      "vat-knowledge-resources",
      "vat-skill-distribution",
      "vat-skill-authoring",
      "vat-audit",
      "vat-rag",
      "vat-skill-review",
      "vat-skill-testing",
      "vat-enterprise-org",
      "markdown-rewriting",
      "coherence-audit"
    ],
    "replaces": {
      "plugins": [
        "vat-development-agents"
      ],
      "flatSkills": [
        "vibe-agent-toolkit",
        "resources"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../cli/dist/bin/vat.js build",
    "build:skills": "node ../cli/dist/bin/vat.js skills build",
    "postinstall": "vat claude plugin install --npm-postinstall || exit 0",
    "test:system": "vitest run --config vitest.system.config.ts",
    "clean": "rimraf --glob dist"
  },
  "dependencies": {
    "@vibe-agent-toolkit/cli": "workspace:*"
  },
  "devDependencies": {
    "@vibe-agent-toolkit/utils": "workspace:*",
    "yaml": "^2.9.0"
  },
  "author": "VAT Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git"
  }
}
