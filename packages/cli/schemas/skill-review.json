{
  "$ref": "#/definitions/skill-review",
  "definitions": {
    "skill-review": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ok"
            },
            "examined": {
              "type": "integer",
              "minimum": 0
            },
            "summary": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "integer",
                  "minimum": 0
                },
                "warnings": {
                  "type": "integer",
                  "minimum": 0
                },
                "info": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "errors",
                "warnings",
                "info"
              ],
              "additionalProperties": false
            },
            "gate": {
              "type": "object",
              "properties": {
                "strict": {
                  "type": "boolean"
                }
              },
              "required": [
                "strict"
              ],
              "additionalProperties": false
            },
            "durationMs": {
              "type": "number",
              "minimum": 0
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "field": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string"
                  },
                  "fix": {
                    "type": "string"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "suggestion": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning",
                      "info"
                    ]
                  },
                  "column": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "code",
                  "message",
                  "severity"
                ],
                "additionalProperties": false
              },
              "maxItems": 0
            },
            "data": {
              "type": "object",
              "properties": {
                "skill": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object",
                  "properties": {
                    "skillLines": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "totalLines": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "fileCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "directFileCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "maxLinkDepth": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "excludedReferenceCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "excludedReferences": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          },
                          "matchedPattern": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "reason"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "skillLines",
                    "totalLines",
                    "fileCount",
                    "directFileCount",
                    "maxLinkDepth",
                    "excludedReferenceCount",
                    "excludedReferences"
                  ],
                  "additionalProperties": false
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "section": {
                        "type": "string"
                      },
                      "codes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "manual": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "section",
                      "codes",
                      "manual"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "skill",
                "source",
                "metadata",
                "sections"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "examined",
            "summary",
            "gate",
            "findings",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "findings"
            },
            "examined": {
              "$ref": "#/definitions/skill-review/anyOf/0/properties/examined"
            },
            "summary": {
              "$ref": "#/definitions/skill-review/anyOf/0/properties/summary"
            },
            "gate": {
              "$ref": "#/definitions/skill-review/anyOf/0/properties/gate"
            },
            "durationMs": {
              "$ref": "#/definitions/skill-review/anyOf/0/properties/durationMs"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/skill-review/anyOf/0/properties/findings/items"
              },
              "minItems": 1
            },
            "data": {
              "$ref": "#/definitions/skill-review/anyOf/0/properties/data"
            }
          },
          "required": [
            "status",
            "examined",
            "summary",
            "gate",
            "findings",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "error"
            },
            "examined": {
              "$ref": "#/definitions/skill-review/anyOf/0/properties/examined"
            },
            "summary": {
              "$ref": "#/definitions/skill-review/anyOf/0/properties/summary"
            },
            "gate": {
              "$ref": "#/definitions/skill-review/anyOf/0/properties/gate"
            },
            "durationMs": {
              "$ref": "#/definitions/skill-review/anyOf/0/properties/durationMs"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/skill-review/anyOf/0/properties/findings/items"
              }
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "USAGE_INVALID",
                    "CONFIG_INVALID",
                    "INPUT_UNREADABLE",
                    "BACKEND_UNAVAILABLE",
                    "EXTERNAL_API_FAILED",
                    "NOT_IMPLEMENTED",
                    "RUN_INCOMPLETE",
                    "INTERNAL_ERROR",
                    "RESOURCE_CHECK_BROKEN",
                    "ARD_NOT_CONFIGURED",
                    "ARD_DERIVATION_FAILED"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            "data": {
              "anyOf": [
                {
                  "$ref": "#/definitions/skill-review/anyOf/0/properties/data"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "examined",
            "summary",
            "gate",
            "findings",
            "error",
            "data"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
