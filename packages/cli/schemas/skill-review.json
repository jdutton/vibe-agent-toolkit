{
  "$ref": "#/definitions/skill-review",
  "definitions": {
    "skill-review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "findings",
            "error"
          ]
        },
        "examined": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "field": {
                "type": "string"
              },
              "link": {
                "type": "string"
              },
              "fix": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "suggestion": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "column": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "code",
              "message",
              "severity"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "warnings": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "errors",
            "warnings",
            "info"
          ],
          "additionalProperties": false
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "error": {
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "skill": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object",
                  "properties": {
                    "skillLines": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "totalLines": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "fileCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "directFileCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "maxLinkDepth": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "excludedReferenceCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "excludedReferences": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          },
                          "matchedPattern": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "reason"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "skillLines",
                    "totalLines",
                    "fileCount",
                    "directFileCount",
                    "maxLinkDepth",
                    "excludedReferenceCount",
                    "excludedReferences"
                  ],
                  "additionalProperties": false
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "section": {
                        "type": "string"
                      },
                      "codes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "manual": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "section",
                      "codes",
                      "manual"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "skill",
                "source",
                "metadata",
                "sections"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "examined",
        "findings",
        "summary",
        "data"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
