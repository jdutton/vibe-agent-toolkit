            "examined": {
              "$ref": "#/definitions/audit/anyOf/0/properties/examined"
            },
            "summary": {
              "$ref": "#/definitions/audit/anyOf/0/properties/summary"
            },
            "gate": {
              "$ref": "#/definitions/audit/anyOf/0/properties/gate"
