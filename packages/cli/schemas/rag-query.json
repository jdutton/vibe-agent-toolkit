{
  "$ref": "#/definitions/rag-query",
  "definitions": {
    "rag-query": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ok"
            },
            "examined": {
              "type": "integer",
              "minimum": 0
            },
            "summary": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "integer",
                  "minimum": 0
                },
                "warnings": {
                  "type": "integer",
                  "minimum": 0
                },
                "info": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "errors",
                "warnings",
                "info"
              ],
              "additionalProperties": false
            },
            "gate": {
              "type": "object",
              "properties": {
                "strict": {
                  "type": "boolean"
                }
              },
              "required": [
                "strict"
              ],
              "additionalProperties": false
            },
            "durationMs": {
              "type": "number",
              "minimum": 0
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "field": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string"
                  },
                  "fix": {
                    "type": "string"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "suggestion": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning",
                      "info"
                    ]
                  },
                  "column": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "code",
                  "message",
                  "severity"
                ],
                "additionalProperties": false
              },
              "maxItems": 0
            },
            "data": {
              "type": "object",
              "properties": {
                "root": {
                  "type": "string"
                },
                "query": {
                  "type": "string"
                },
                "stats": {
                  "type": "object",
                  "properties": {
                    "totalMatches": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "searchDurationMs": {
                      "type": "number",
                      "minimum": 0
                    },
                    "embedding": {
                      "type": "object",
                      "properties": {
                        "model": {
                          "type": "string"
                        },
                        "tokensUsed": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "model"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "totalMatches",
                    "searchDurationMs"
                  ],
                  "additionalProperties": false
                },
                "chunks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "chunkId": {
                        "type": "string"
                      },
                      "resourceId": {
                        "type": "string"
                      },
                      "filePath": {
                        "type": "string"
                      },
                      "headingPath": {
                        "type": "string"
                      },
                      "headingLevel": {
                        "type": "integer"
                      },
                      "startLine": {
                        "type": "integer"
                      },
                      "endLine": {
                        "type": "integer"
                      },
                      "title": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "contentHash": {
                        "type": "string"
                      },
                      "tokenCount": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "embeddingModel": {
                        "type": "string"
                      },
                      "embeddedAt": {
                        "type": "string"
                      },
                      "previousChunkId": {
                        "type": "string"
                      },
                      "nextChunkId": {
                        "type": "string"
                      },
                      "content": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "chunkId",
                      "resourceId",
                      "filePath",
                      "contentHash",
                      "tokenCount",
                      "embeddingModel",
                      "embeddedAt",
                      "content"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "root",
                "query",
                "stats",
                "chunks"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "examined",
            "summary",
            "gate",
            "findings",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "findings"
            },
            "examined": {
              "$ref": "#/definitions/rag-query/anyOf/0/properties/examined"
            },
            "summary": {
              "$ref": "#/definitions/rag-query/anyOf/0/properties/summary"
            },
            "gate": {
              "$ref": "#/definitions/rag-query/anyOf/0/properties/gate"
            },
            "durationMs": {
              "$ref": "#/definitions/rag-query/anyOf/0/properties/durationMs"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/rag-query/anyOf/0/properties/findings/items"
              },
              "minItems": 1
            },
            "data": {
              "$ref": "#/definitions/rag-query/anyOf/0/properties/data"
            }
          },
          "required": [
            "status",
            "examined",
            "summary",
            "gate",
            "findings",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "error"
            },
            "examined": {
              "$ref": "#/definitions/rag-query/anyOf/0/properties/examined"
            },
            "summary": {
              "$ref": "#/definitions/rag-query/anyOf/0/properties/summary"
            },
            "gate": {
              "$ref": "#/definitions/rag-query/anyOf/0/properties/gate"
            },
            "durationMs": {
              "$ref": "#/definitions/rag-query/anyOf/0/properties/durationMs"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/rag-query/anyOf/0/properties/findings/items"
              }
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "USAGE_INVALID",
                    "CONFIG_INVALID",
                    "INPUT_UNREADABLE",
                    "BACKEND_UNAVAILABLE",
                    "EXTERNAL_API_FAILED",
                    "NOT_IMPLEMENTED",
                    "RUN_INCOMPLETE",
                    "INTERNAL_ERROR",
                    "RESOURCE_CHECK_BROKEN",
                    "ARD_NOT_CONFIGURED",
                    "ARD_DERIVATION_FAILED"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            "data": {
              "anyOf": [
                {
                  "$ref": "#/definitions/rag-query/anyOf/0/properties/data"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "examined",
            "summary",
            "gate",
            "findings",
            "error",
            "data"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
