{
  "$ref": "#/definitions/resources-check",
  "definitions": {
    "resources-check": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ok"
            },
            "examined": {
              "type": "integer",
              "minimum": 0
            },
            "summary": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "integer",
                  "minimum": 0
                },
                "warnings": {
                  "type": "integer",
                  "minimum": 0
                },
                "info": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "errors",
                "warnings",
                "info"
              ],
              "additionalProperties": false
            },
            "gate": {
              "type": "object",
              "properties": {
                "strict": {
                  "type": "boolean"
                }
              },
              "required": [
                "strict"
              ],
              "additionalProperties": false
            },
            "durationMs": {
              "type": "number",
              "minimum": 0
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string",
                    "description": "The file to open to fix this: a non-empty relative path with / separators inside the root (no leading /, no drive, no climbing .., and no \\ where \\ is the platform separator)"
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "column": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "field": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string"
                  },
                  "fix": {
                    "type": "string"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "suggestion": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning",
                      "info"
                    ]
                  },
                  "check": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "refusal": {
                            "type": "string",
                            "enum": [
                              "USAGE_INVALID",
                              "BACKEND_UNAVAILABLE",
                              "INPUT_UNREADABLE"
                            ]
                          }
                        },
                        "required": [
                          "refusal"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "column": {
                            "type": "string",
                            "enum": [
                              "path",
                              "finding_severity",
                              "finding_line",
                              "finding_column"
                            ]
                          },
                          "value": {
                            "$ref": "#/definitions/resources-check/anyOf/0/properties/findings/items/properties/evidence/additionalProperties"
                          },
                          "row": {
                            "type": "integer",
                            "exclusiveMinimum": 0
                          },
                          "allowed": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "column",
                          "value",
                          "row",
                          "allowed"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "statement": {
                            "type": "string",
                            "const": "examined"
                          },
                          "rows": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "columns": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "value": {
                            "$ref": "#/definitions/resources-check/anyOf/0/properties/findings/items/properties/evidence/additionalProperties"
                          },
                          "allowed": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "statement",
                          "rows",
                          "allowed"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "code",
                  "message",
                  "severity"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "anyOf": [
                      {
                        "not": {
                          "required": [
                            "evidence"
                          ]
                        }
                      },
                      {
                        "required": [
                          "check"
                        ]
                      }
                    ]
                  },
                  {
                    "anyOf": [
                      {
                        "not": {
                          "required": [
                            "reason"
                          ]
                        }
                      },
                      {
                        "required": [
                          "code"
                        ],
                        "properties": {
                          "code": {
                            "const": "RESOURCE_CHECK_BROKEN"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "maxItems": 0
            },
            "data": {
              "type": "object",
              "properties": {
                "root": {
                  "type": "string"
                },
                "population": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "store",
                        "derived"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "populationSecs": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lensSecs": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lensesEvaluated": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lensPopulation": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "none",
                        "store",
                        "derived"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "boundsStatement": {
                  "type": "string"
                },
                "limits": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "over-report",
                          "under-report",
                          "scope",
                          "assumption"
                        ]
                      },
                      "statement": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "direction",
                      "statement"
                    ],
                    "additionalProperties": false
                  }
                },
                "checksRun": {
                  "type": "integer",
                  "minimum": 0
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "durationSecs": {
                        "type": "number",
                        "minimum": 0
                      },
                      "rows": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "broken": {
                        "type": "boolean",
                        "const": true
                      },
                      "builtin": {
                        "type": "boolean",
                        "const": true
                      },
                      "examined": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "allowEmpty": {
                        "type": "boolean",
                        "const": true
                      },
                      "nearMisses": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1
                      },
                      "examinedNothing": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "name",
                      "durationSecs"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "root",
                "population",
                "populationSecs",
                "lensSecs",
                "lensesEvaluated",
                "lensPopulation",
                "checksRun",
                "checks"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "examined",
            "summary",
            "gate",
            "findings",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "findings"
            },
            "examined": {
              "$ref": "#/definitions/resources-check/anyOf/0/properties/examined"
            },
            "summary": {
              "$ref": "#/definitions/resources-check/anyOf/0/properties/summary"
            },
            "gate": {
              "$ref": "#/definitions/resources-check/anyOf/0/properties/gate"
            },
            "durationMs": {
              "$ref": "#/definitions/resources-check/anyOf/0/properties/durationMs"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/resources-check/anyOf/0/properties/findings/items"
              },
              "minItems": 1
            },
            "data": {
              "$ref": "#/definitions/resources-check/anyOf/0/properties/data"
            }
          },
          "required": [
            "status",
            "examined",
            "summary",
            "gate",
            "findings",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "error"
            },
            "examined": {
              "$ref": "#/definitions/resources-check/anyOf/0/properties/examined"
            },
            "summary": {
              "$ref": "#/definitions/resources-check/anyOf/0/properties/summary"
            },
            "gate": {
              "$ref": "#/definitions/resources-check/anyOf/0/properties/gate"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/resources-check/anyOf/0/properties/findings/items"
              }
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "USAGE_INVALID",
                    "CONFIG_INVALID",
                    "INPUT_UNREADABLE",
                    "BACKEND_UNAVAILABLE",
                    "EXTERNAL_API_FAILED",
                    "NOT_IMPLEMENTED",
                    "RUN_INCOMPLETE",
                    "INTERNAL_ERROR",
                    "RESOURCE_CHECK_BROKEN",
                    "RESOURCE_CHECK_EXAMINED_NOTHING",
                    "ARD_NOT_CONFIGURED",
                    "ARD_DERIVATION_FAILED"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            "data": {
              "anyOf": [
                {
                  "$ref": "#/definitions/resources-check/anyOf/0/properties/data"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "examined",
            "summary",
            "gate",
            "findings",
            "error",
            "data"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
