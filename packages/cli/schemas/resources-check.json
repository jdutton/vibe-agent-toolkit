{
  "$ref": "#/definitions/resources-check",
  "definitions": {
    "resources-check": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "findings",
            "error"
          ]
        },
        "examined": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "field": {
                "type": "string"
              },
              "link": {
                "type": "string"
              },
              "fix": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "suggestion": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "column": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "code",
              "message",
              "severity"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "warnings": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "errors",
            "warnings",
            "info"
          ],
          "additionalProperties": false
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "error": {
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "root": {
                  "type": "string"
                },
                "population": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "derived",
                        "store"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "populationSecs": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lensSecs": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lensesEvaluated": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "boundsStatement": {
                  "type": "string"
                },
                "limits": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "over-report",
                          "under-report",
                          "scope",
                          "assumption"
                        ]
                      },
                      "statement": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "direction",
                      "statement"
                    ],
                    "additionalProperties": false
                  }
                },
                "checksRun": {
                  "type": "integer",
                  "minimum": 0
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "durationSecs": {
                        "type": "number",
                        "minimum": 0
                      },
                      "rows": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "broken": {
                        "type": "boolean",
                        "const": true
                      },
                      "builtin": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "name",
                      "durationSecs"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "root",
                "population",
                "populationSecs",
                "lensSecs",
                "lensesEvaluated",
                "checksRun",
                "checks"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "examined",
        "findings",
        "summary",
        "data"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
