{
  "name": "@vibe-agent-toolkit/vat-example-cat-agents",
  "version": "0.2.0-rc.3",
  "description": "Example agents: 8 quirky cat agents demonstrating VAT patterns",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp-collections": {
      "types": "./dist/mcp-collections.d.ts",
      "default": "./dist/mcp-collections.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:resources": "vat-compile-resources compile resources/ generated/resources/",
    "build:code": "bun run generate:resources && tsx ../dev-tools/src/tsc-clean-build.ts && bun scripts/post-build.ts",
    "build": "bun run build:code",
    "build:skills": "node ../cli/dist/bin/vat.js skills build",
    "lint": "eslint src/ test/ examples/",
    "duplication-check": "echo 'Duplication check not applicable to example packages'",
    "validate-structure": "echo 'Structure validation not applicable to example packages'",
    "pre-publish": "echo 'Pre-publish checks not applicable to example packages'",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "demo:photos": "bun examples/photo-analysis-demo.ts",
    "demo:conversation": "bun examples/conversational-demo.ts",
    "demo:resources": "bun run build && bun examples/resource-demo.ts",
    "postinstall": "vat skills install --npm-postinstall || exit 0"
  },
  "dependencies": {
    "@vibe-agent-toolkit/agent-runtime": "workspace:*",
    "@vibe-agent-toolkit/schema": "workspace:*",
    "@vibe-agent-toolkit/transports": "workspace:*",
    "syllable": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.45",
    "@anthropic-ai/sdk": "^0.120.0",
    "@langchain/openai": "^1.5.10",
    "@types/node": "^26.2.0",
    "@vibe-agent-toolkit/resource-compiler": "workspace:*",
    "@vibe-agent-toolkit/runtime-claude-agent-sdk": "workspace:*",
    "@vibe-agent-toolkit/runtime-langchain": "workspace:*",
    "@vibe-agent-toolkit/runtime-openai": "workspace:*",
    "@vitest/coverage-v8": "^4.1.11",
    "ai": "^7.0.74",
    "openai": "^7.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "vat": {
    "version": "1.0",
    "type": "agent-bundle",
    "skills": [
      {
        "name": "vat-example-cat-agents",
        "source": "./resources/skills/SKILL.md",
        "path": "./dist/skills/vat-example-cat-agents"
      }
    ]
  },
  "keywords": [
    "ai-agent",
    "cat-agents",
    "vibe-agent-toolkit",
    "example"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/vat-example-cat-agents"
  }
}
