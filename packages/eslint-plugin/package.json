{
  "name": "@vibe-agent-toolkit/eslint-plugin",
  "version": "0.1.41",
  "description": "ESLint rules that enforce the cross-platform and agentic-code safety helpers in @vibe-agent-toolkit/utils",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "cross-platform",
    "windows",
    "typescript"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./index.cjs",
  "exports": {
    ".": "./index.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "rules",
    "README.md"
  ],
  "scripts": {
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@vibe-agent-toolkit/utils": "workspace:*",
    "eslint": "^9.39.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/jdutton/vibe-agent-toolkit/issues"
  },
  "homepage": "https://github.com/jdutton/vibe-agent-toolkit/tree/main/packages/eslint-plugin#readme"
}
