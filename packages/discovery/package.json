{
  "name": "@vibe-agent-toolkit/discovery",
  "version": "0.2.0-rc.9",
  "description": "Intelligent file discovery for VAT agents and Agent Skills",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsx ../dev-tools/src/tsc-clean-build.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\" .tsc-staging"
  },
  "dependencies": {
    "@vibe-agent-toolkit/utils": "workspace:*",
    "picomatch": "^4.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/discovery"
  },
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
