{
  "name": "@vibe-agent-toolkit/runtime-langchain",
  "version": "0.2.0-rc.2",
  "description": "LangChain.js runtime adapter for VAT agents",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx ../dev-tools/src/tsc-clean-build.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:llm-regression": "RUN_LLM_TESTS=true bun test test/llm-regression.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@vibe-agent-toolkit/agent-runtime": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langchain/openai": "^1.5.6",
    "@types/node": "^26.2.0",
    "@vibe-agent-toolkit/dev-tools": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@vibe-agent-toolkit/test-agents": "workspace:*"
  },
  "keywords": [
    "ai-agent",
    "langchain",
    "vibe-agent-toolkit",
    "runtime-adapter"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/runtime-langchain"
  }
}
