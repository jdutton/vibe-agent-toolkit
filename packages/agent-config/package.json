{
  "name": "@vibe-agent-toolkit/agent-config",
  "version": "0.2.0-rc.8",
  "description": "Agent manifest loading and validation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsx ../dev-tools/src/tsc-clean-build.ts",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\" .tsc-staging",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibe-agent-toolkit/schema": "workspace:*",
    "@vibe-agent-toolkit/utils": "workspace:*",
    "yaml": "^2.9.0"
  },
  "keywords": [
    "ai",
    "agent",
    "config",
    "validation",
    "manifest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/agent-config"
  },
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
