{
  "name": "@vibe-agent-toolkit/agent-config",
  "version": "0.1.41-rc.3",
  "description": "Agent manifest loading and validation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "rm -rf dist",
    "test:unit": "vitest run",
    "test:integration": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibe-agent-toolkit/agent-schema": "workspace:*",
    "@vibe-agent-toolkit/utils": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "ai",
    "agent",
    "config",
    "validation",
    "manifest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/agent-config"
  },
  "author": "Jeff Dutton",
  "license": "MIT"
}
