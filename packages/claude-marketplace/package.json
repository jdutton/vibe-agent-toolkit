{
  "name": "@vibe-agent-toolkit/claude-marketplace",
  "version": "0.2.0-rc.10",
  "description": "Claude plugin marketplace tools: compatibility analysis, provenance tracking, enterprise config",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsx ../dev-tools/src/tsc-clean-build.ts",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\" .tsc-staging",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:system": "vitest run --config vitest.system.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibe-agent-toolkit/schema": "workspace:*",
    "@vibe-agent-toolkit/agent-skills": "workspace:*",
    "@vibe-agent-toolkit/resources": "workspace:*",
    "@vibe-agent-toolkit/utils": "workspace:*",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "ignore": "^7.0.5"
  },
  "keywords": [
    "claude",
    "marketplace",
    "plugin",
    "compatibility",
    "enterprise"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/claude-marketplace"
  },
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
