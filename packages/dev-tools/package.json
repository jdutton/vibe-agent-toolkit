{
  "name": "@vibe-agent-toolkit/dev-tools",
  "version": "0.2.0-rc.3",
  "private": true,
  "type": "module",
  "description": "Development tools for the monorepo",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsx src/tsc-clean-build.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rimraf dist *.tsbuildinfo",
    "prepare-bin": "tsx src/prepare-bin.ts",
    "generate-cli-docs": "tsx src/generate-cli-docs.ts",
    "validate-structure": "tsx src/validate-repo-structure.ts",
    "process-images": "tsx src/process-test-images.ts",
    "compat-empirical": "tsx src/compat-empirical/index.ts"
  },
  "dependencies": {
    "@vibe-agent-toolkit/agent-skills": "workspace:*",
    "@vibe-agent-toolkit/claude-marketplace": "workspace:*",
    "@vibe-agent-toolkit/utils": "workspace:*",
    "commander": "^15.0.0",
    "semver": "^7.7.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/semver": "^7.5.0",
    "@types/which": "^3.0.4",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git"
  }
}
