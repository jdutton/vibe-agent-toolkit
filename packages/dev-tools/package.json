{
  "name": "@vibe-agent-toolkit/dev-tools",
  "version": "0.2.0-rc.10",
  "private": true,
  "type": "module",
  "description": "Development tools for the monorepo",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsx src/tsc-clean-build.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\" .tsc-staging",
    "prepare-bin": "tsx src/prepare-bin.ts",
    "generate:tsconfig-refs": "tsx src/generate-tsconfig-refs.ts",
    "generate:claude-md": "tsx src/generate-claude-md.ts",
    "generate:workflow": "tsx src/generate-workflow.ts",
    "process-images": "tsx src/process-test-images.ts",
    "compat-empirical": "tsx src/compat-empirical/index.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vibe-agent-toolkit/agent-skills": "workspace:*",
    "@vibe-agent-toolkit/claude-marketplace": "workspace:*",
    "@vibe-agent-toolkit/resources": "workspace:*",
    "@vibe-agent-toolkit/schema": "workspace:*",
    "@vibe-agent-toolkit/utils": "workspace:*",
    "commander": "^12.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-front-matter": "^0.2.4",
    "semver": "^7.8.5",
    "which": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/which": "^3.0.4",
    "sharp": "^0.35.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git"
  }
}
