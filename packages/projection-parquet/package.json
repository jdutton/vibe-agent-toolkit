{
  "name": "@vibe-agent-toolkit/projection-parquet",
  "version": "0.2.0-rc.2",
  "description": "Parquet writer for VAT resource projections, backed by DuckDB WASM",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsx ../dev-tools/src/tsc-clean-build.ts",
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "parquet",
    "duckdb",
    "wasm",
    "projection",
    "resources",
    "agent-toolkit"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@vibe-agent-toolkit/resources": "workspace:*",
    "@vibe-agent-toolkit/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/projection-parquet"
  }
}
