{
  "name": "@vibe-agent-toolkit/resource-compiler",
  "version": "0.2.0-rc.3",
  "description": "Compile markdown resources to TypeScript with full IDE support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vat-compile-resources": "./bin/vat-compile-resources"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./transformer": {
      "types": "./dist/transformer/index.d.ts",
      "default": "./dist/transformer/index.js"
    },
    "./language-service": {
      "types": "./dist/language-service/index.d.ts",
      "default": "./dist/language-service/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "tsx ../dev-tools/src/tsc-clean-build.ts",
    "build:clean": "tsc --build --clean && tsc --build",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --build --dry --force"
  },
  "dependencies": {
    "@vibe-agent-toolkit/resources": "workspace:*",
    "@vibe-agent-toolkit/utils": "workspace:*",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "github-slugger": "^2.0.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "eslint": "^10.9.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "keywords": [
    "markdown",
    "typescript",
    "compiler",
    "resources",
    "prompts",
    "agents",
    "vat",
    "vibe-agent-toolkit"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/resource-compiler"
  }
}
