{
  "$ref": "#/definitions/vat-package-metadata",
  "definitions": {
    "vat-package-metadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "VAT metadata schema version (currently \"1.0\")"
        },
        "type": {
          "type": "string",
          "enum": [
            "agent-bundle",
            "skill",
            "runtime",
            "toolkit"
          ],
          "description": "DEPRECATED: Do not use. Will be removed in v1.0. A package can contain multiple artifact types."
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(:[a-z0-9]+(-[a-z0-9]+)*)?$",
            "description": "Skill name for distribution (must match a discovered skill in config yaml)"
          },
          "description": "Skill names for npm discoverability"
        },
        "replaces": {
          "type": "object",
          "properties": {
            "plugins": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Old plugin names (without marketplace) this package used to publish under"
            },
            "flatSkills": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Old skill names installed to ~/.claude/skills/<name> (the legacy flat location); each must be a single path segment"
            }
          },
          "additionalProperties": false,
          "description": "What `vat claude plugin install` removes before installing this package"
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": true,
      "description": "VAT package metadata (package.json \"vat\" field)"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
