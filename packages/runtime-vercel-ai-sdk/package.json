{
  "name": "@vibe-agent-toolkit/runtime-vercel-ai-sdk",
  "version": "0.2.0-rc.8",
  "description": "Vercel AI SDK runtime adapter for VAT agents",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx ../dev-tools/src/tsc-clean-build.ts",
    "llm-demo": "tsx examples/llm-agent-demo.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:llm-regression": "RUN_LLM_TESTS=true bun test test/llm-regression.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\" .tsc-staging"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.4",
    "@ai-sdk/provider-utils": "^4.0.8",
    "@vibe-agent-toolkit/agent-runtime": "workspace:*",
    "ai": "^6.0.48",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.15",
    "@ai-sdk/openai": "^3.0.18",
    "@vibe-agent-toolkit/dev-tools": "workspace:*",
    "@vibe-agent-toolkit/test-agents": "workspace:*"
  },
  "keywords": [
    "ai-agent",
    "vercel-ai-sdk",
    "vibe-agent-toolkit",
    "runtime-adapter"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/runtime-vercel-ai-sdk"
  }
}
