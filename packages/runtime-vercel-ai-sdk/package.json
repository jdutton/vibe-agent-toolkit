{
  "name": "@vibe-agent-toolkit/runtime-vercel-ai-sdk",
  "version": "0.1.41-rc.3",
  "description": "Vercel AI SDK runtime adapter for VAT agents",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "llm-demo": "tsx examples/llm-agent-demo.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:llm-regression": "RUN_LLM_TESTS=true bun test test/llm-regression.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.3",
    "@ai-sdk/provider-utils": "^5.0.10",
    "@vibe-agent-toolkit/agent-runtime": "workspace:*",
    "ai": "^7.0.29",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.15",
    "@ai-sdk/openai": "^4.0.15",
    "@types/node": "^26.1.1",
    "@vibe-agent-toolkit/dev-tools": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@vibe-agent-toolkit/test-agents": "workspace:*"
  },
  "keywords": [
    "ai-agent",
    "vercel-ai-sdk",
    "vibe-agent-toolkit",
    "runtime-adapter"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/runtime-vercel-ai-sdk"
  }
}
