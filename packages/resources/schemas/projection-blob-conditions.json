{
  "$ref": "#/definitions/projection-blob-conditions",
  "definitions": {
    "projection-blob-conditions": {
      "type": "object",
      "properties": {
        "blob": {
          "type": "string",
          "pattern": "^(?:markdown|html|none)\\.(?:sha256\\.[0-9a-f]{64}|git-sha1\\.[0-9a-f]{40}|git-sha256\\.[0-9a-f]{64})$",
          "description": "Foreign key to blobs.contentKey"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "An enum member, or \"PARSE_ODDITY\" for an unclassified oddity"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based position among this blob's rows of this code, in the order the parse reported them: two identical findings are two rows, and the order is the parser's, not the key's"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "1-based line, or null when the finding names none"
        }
      },
      "required": [
        "blob",
        "code",
        "ordinal",
        "severity",
        "message",
        "line"
      ],
      "additionalProperties": false,
      "description": "A row of the blob-keyed `blob_conditions` table"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
