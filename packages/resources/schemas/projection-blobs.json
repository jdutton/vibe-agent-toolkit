{
  "$ref": "#/definitions/projection-blobs",
  "definitions": {
    "projection-blobs": {
      "type": "object",
      "properties": {
        "contentKey": {
          "type": "string",
          "pattern": "^(?:markdown|html)\\.[0-9a-f]{64}$",
          "description": "Primary key — see content-key.ts"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Raw on-disk byte length of the blob — NOT necessarily UTF-8 bytes. For a BOM'd UTF-16 or UTF-32 source this differs from the sum of that blob's `blob_sections.bytes`, which are UTF-8 bytes of the decoded text"
        },
        "tokenEstimate": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated token count for LLM context"
        },
        "frontmatter": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/projection-blobs/properties/frontmatter/anyOf/0/additionalProperties"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/definitions/projection-blobs/properties/frontmatter/anyOf/0/additionalProperties"
                    }
                  }
                ],
                "description": "An arbitrary JSON value (frontmatter, condition payloads, etc.)"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Parsed frontmatter as JSON, or null when the blob has no frontmatter block"
        },
        "frontmatterError": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why frontmatter did not parse to an object, or null when it did (including \"no block at all\")"
        },
        "wordCount": {
          "type": "integer",
          "minimum": 0
        },
        "proseCharacters": {
          "type": "integer",
          "minimum": 0,
          "description": "Unicode code points outside fenced/inline code"
        },
        "codeBlockCharacters": {
          "type": "integer",
          "minimum": 0,
          "description": "Unicode code points inside fenced code blocks"
        },
        "linkCount": {
          "type": "integer",
          "minimum": 0
        },
        "headingCount": {
          "type": "integer",
          "minimum": 0
        },
        "sectionCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "contentKey",
        "bytes",
        "tokenEstimate",
        "frontmatter",
        "frontmatterError",
        "wordCount",
        "proseCharacters",
        "codeBlockCharacters",
        "linkCount",
        "headingCount",
        "sectionCount"
      ],
      "additionalProperties": false,
      "description": "A row of the blob-keyed `blobs` table"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
