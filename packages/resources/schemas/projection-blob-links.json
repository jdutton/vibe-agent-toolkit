{
  "$ref": "#/definitions/projection-blob-links",
  "definitions": {
    "projection-blob-links": {
      "type": "object",
      "properties": {
        "blob": {
          "type": "string",
          "pattern": "^(?:markdown|html)\\.[0-9a-f]{64}$",
          "description": "Foreign key to blobs.contentKey"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based position among this blob's links"
        },
        "rawHref": {
          "type": "string",
          "description": "The href exactly as authored — unresolved"
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Link text, or null for a bare autolink"
        },
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "column": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "nodeType": {
          "type": "string",
          "enum": [
            "link",
            "linkReference",
            "definition"
          ],
          "description": "AST node type that produced this link"
        },
        "inCodeSpan": {
          "type": "boolean",
          "description": "True when the link sits inside an inline code span"
        },
        "inFence": {
          "type": "boolean",
          "description": "True when the link sits inside a fenced code block"
        }
      },
      "required": [
        "blob",
        "ordinal",
        "rawHref",
        "text",
        "line",
        "column",
        "nodeType",
        "inCodeSpan",
        "inFence"
      ],
      "additionalProperties": false,
      "description": "A row of the blob-keyed `blob_links` table"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
