{
  "$ref": "#/definitions/projection-edges",
  "definitions": {
    "projection-edges": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1,
          "description": "Source resource id"
        },
        "refOrdinal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Matches blob_references.ordinal for the src blob. Null for an implicit edge, which has no authored reference."
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "description": "Foreign key to resolution_contexts.contextId — resolution is per-context"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Edge kind — open vocabulary, e.g. \"local_file\", \"external\", \"ancestor-context\", \"rules-glob-match\""
        },
        "origin": {
          "type": "string",
          "enum": [
            "authored",
            "implicit",
            "inferred"
          ],
          "description": "Whether this edge was authored, implied by the reader's rules, or inferred by a scoring lens"
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "description": "Resolution tier — open vocabulary, e.g. \"resolved\", \"same-marketplace\", \"auth-required\", \"nonexistent\""
        }
      },
      "required": [
        "src",
        "refOrdinal",
        "contextId",
        "kind",
        "origin",
        "resolution"
      ],
      "additionalProperties": false,
      "description": "A row of the path-dependent `edges` table. Note: the implicit/refOrdinal correspondence is enforced by the Zod schema but not encoded in the generated JSON Schema."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
