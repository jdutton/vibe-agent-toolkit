{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.cts", "**/*.mts"],
  "exclude": ["**/dist", "**/node_modules", "**/coverage", "**/generated", "**/.tsc-staging"]
}
