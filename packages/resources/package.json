{
  "name": "@vibe-agent-toolkit/resources",
  "version": "0.1.41-rc.5",
  "description": "Markdown resource parsing, validation, and link integrity checking",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:system": "vitest run --config vitest.system.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "keywords": [
    "markdown",
    "validation",
    "links",
    "resources",
    "agent-toolkit"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "dependencies": {
    "@vibe-agent-toolkit/agent-schema": "workspace:*",
    "@vibe-agent-toolkit/utils": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "github-slugger": "^2.0.0",
    "markdown-link-check": "^3.14.2",
    "mdast-util-to-string": "^4.0.0",
    "parse5": "^7.3.0",
    "picomatch": "^4.0.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "semver": "^7.7.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.5",
    "@types/picomatch": "^4.0.2",
    "@types/semver": "^7.7.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git"
  }
}
