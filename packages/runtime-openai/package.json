{
  "name": "@vibe-agent-toolkit/runtime-openai",
  "version": "0.2.0-rc.2",
  "description": "OpenAI SDK runtime adapter for VAT agents",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx ../dev-tools/src/tsc-clean-build.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:llm-regression": "RUN_LLM_TESTS=true bun test test/llm-regression.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibe-agent-toolkit/agent-runtime": "workspace:*",
    "openai": "^7.4.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vibe-agent-toolkit/dev-tools": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@vibe-agent-toolkit/test-agents": "workspace:*"
  },
  "keywords": [
    "ai-agent",
    "openai",
    "vibe-agent-toolkit",
    "runtime-adapter"
  ],
  "author": "Jeff Dutton",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdutton/vibe-agent-toolkit.git",
    "directory": "packages/runtime-openai"
  }
}
