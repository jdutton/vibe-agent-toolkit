{
  "$schema": "https://turbo.build/schema.json",
  // The local cache (`.turbo/cache` of the main checkout, shared by every linked
  // worktree) had no eviction and reached 9.7 GB. Entries go after 30 days; the
  // size cap sits above what 30 days of entries measured (2.8 GB on 2026-11-14),
  // so it only bites if the rate of new entries roughly doubles — a cap below
  // that would silently shorten the 30-day window. No `cacheDir`: the default is
  // what shares the cache across worktrees.
  "cacheMaxAge": "30d",
  "cacheMaxSize": "5GB",
  "tasks": {
    // `*.tsbuildinfo` is a build output and must be cached with `dist/**`, not left
    // behind. Restoring `dist/` without it puts the package in a state TypeScript
    // reads as "never built": the next `tsc` re-emits every file even though the
    // output is already correct, and a `tsc --build` elsewhere in the repo would
    // conclude this project is stale and emit into *this* package's `dist/` from
    // outside turbo's ordering. Both are pure write traffic against a directory
    // other tasks are concurrently reading.
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo", "**/*.schema.json", "schemas/**"],
      "cache": true
    },
    // resources extends this entry in `packages/resources/turbo.json` with `$TURBO_EXTENDS$`. Its
    // build's last step (`dev-tools/src/vendor-typescript.ts`) writes VAT's vendored TypeScript into
    // `src/vendor/` (gitignored) and `dist/vendor/`, so that file appends the three `src/vendor/`
    // files to these outputs (a cache hit restores what the tests read from `src`) and the script and
    // the one dev-tools module it imports (`common.ts`) to the inputs. A package file extends this
    // entry, so an edit here reaches resources' build too; a root `<pkg>#build` entry would replace
    // it whole and silently keep a stale copy.
    // --- Adopter packages ---
    // These packages live in the monorepo but depend on the CLI *binary* at
    // build time (they run `node ../cli/dist/bin/vat.js build` as adopters would).
    // They must NOT be listed as workspace deps of CLI — that creates a cycle.
    // Instead, declare the binary dependency here using package#task syntax so
    // turbo waits for CLI before building each adopter.
    // A new adopter package needs the same edge on whichever task runs the binary
    // ("<pkg>#build", or "<pkg>#build:skills" below); `checkBuiltOutputEdges`
    // (validate-structure) fails until it is there.
    "@vibe-agent-toolkit/vat-development-agents#build": {
      "dependsOn": ["@vibe-agent-toolkit/cli#build", "^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "build:skills": {
      "dependsOn": ["build"],
      "outputs": ["dist/skills/**"],
      "cache": true
    },
    // One `tsc --noEmit -p tsconfig.eslint.json` per package: the same program the lint checks,
    // source and tests alike, so a test file meets the compiler settings source does. Keyed like
    // `lint`, on what the program reads rather than on `^build`: a program reaches packages its
    // manifest does not depend on (`vitest.shared.ts` imports a dev-tools file that imports
    // `schema`), which `^build` neither orders nor hashes. So the root `typecheck` script builds
    // every package first, and the inputs hold every package's emitted declarations and manifest,
    // the lockfile and the installed TypeScript: exactly the `lint` inputs that describe the
    // program, plus the build guard every typecheck runs through (`typecheck-task.js` and what it
    // imports), all checked by `generate-lint-config.ts --check`, both ways. The guard refuses a run
    // the root script did not build for (`VAT_BUILT`, passed through, unhashed), as a package lint
    // is refused, so a stale `dist/` is never checked and cached. A generated
    // `packages/<pkg>/turbo.json` extends the inputs (`$TURBO_EXTENDS$`) with the files outside the
    // package that its program reaches.
    "typecheck": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/dist/**/*.d.ts",
        "$TURBO_ROOT$/packages/*/dist/**/*.d.cts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/node_modules/typescript/package.json",
        "$TURBO_ROOT$/typecheck-task.js",
        "$TURBO_ROOT$/eslint-config-support.js"
      ],
      "passThroughEnv": ["VAT_BUILT"],
      "outputs": [],
      "cache": true
    },
    // The root's own TypeScript program (`tsconfig.root.json`: the root vitest configs,
    // `vitest.shared.ts`, `eslint-config-support.d.ts`), typechecked through the same guard. Not
    // `$TURBO_DEFAULT$`, which for the root is the whole repository. Its inputs are the program's
    // root-level files (one prefixed glob), the files outside the root it reaches that no
    // `globalDependencies` entry hashes (none today: the dev-tools reporter it loads is one), the
    // same program inputs as `typecheck` (the declarations it reaches in `schema` and `utils`, every
    // manifest, the lockfile, the installed TypeScript) and the guard.
    // `generate-lint-config.ts --check` derives all of it from the program, both ways.
    "//#typecheck:root": {
      "dependsOn": [],
      "inputs": [
        "*.{ts,cts,mts}",
        "packages/*/dist/**/*.d.ts",
        "packages/*/dist/**/*.d.cts",
        "packages/*/package.json",
        "bun.lock",
        "node_modules/typescript/package.json",
        "typecheck-task.js",
        "eslint-config-support.js"
      ],
      "passThroughEnv": ["VAT_BUILT"],
      "outputs": [],
      "cache": true
    },
    // One ESLint process per package, each type-checking only its own program
    // (`tsconfig.eslint.json`): a whole-monorepo program peaked at about 3 GB.
    // TURBO is the lint cache, never ESLint's `--cache`: ESLint keys a file on
    // its own mtime and size, so an unchanged caller replays a clean verdict
    // after a type-aware change elsewhere. A lint's inputs are everything its
    // program and its rules read:
    // - its own files (`$TURBO_DEFAULT$`); any change re-lints the whole package;
    // - every package's emitted declarations, `dist/**/*.d.ts` and `*.d.cts`,
    //   which is all a package sees of another through a package import (and of
    //   itself, for a test importing it by name). `.d.ts.map` is not an input:
    //   its line positions move with any edit. An edit that leaves every
    //   declaration byte-identical re-lints only its own package; one that
    //   changes a declaration re-lints every package;
    // - every `package.json` (exports, types, and the library-rule off-list);
    // - the files a package reaches by a RELATIVE import into another package
    //   (a shared test helper, a dev-tools generator), and what those import in
    //   turn: listed per package in a generated `packages/<pkg>/turbo.json`
    //   (`bun run generate:lint-config`; `validate-structure` checks it);
    // - the rule sources, `eslint-config-support.js` and the ignore files
    //   (`eslint.config.js` reads all of them for every package);
    // - `bun.lock`: a program reaching another package's source reads that
    //   package's external types, which this package's own external-dependency
    //   hash does not cover; and the installed linter and TypeScript manifests,
    //   because a worktree sharing this cache may have pulled a lockfile change
    //   without installing it.
    // No `dependsOn`: `^build` would fold the upstream build's hash in, and that
    // changes with every source edit. The root `lint` script runs `turbo run
    // build` first and then sets `VAT_BUILT` (passed through, unhashed); a
    // package's `lint` without it is refused by `eslint.config.js`.
    "lint": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/utils/eslint/**",
        "$TURBO_ROOT$/packages/*/dist/**/*.d.ts",
        "$TURBO_ROOT$/packages/*/dist/**/*.d.cts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/eslint-config-support.js",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/packages/dev-tools/corpus/compat-empirical/run/.gitignore",
        "$TURBO_ROOT$/node_modules/typescript/package.json",
        "$TURBO_ROOT$/node_modules/eslint/package.json",
        "$TURBO_ROOT$/node_modules/@eslint/js/package.json",
        "$TURBO_ROOT$/node_modules/@eslint-community/eslint-plugin-eslint-comments/package.json",
        "$TURBO_ROOT$/node_modules/@typescript-eslint/eslint-plugin/package.json",
        "$TURBO_ROOT$/node_modules/@typescript-eslint/parser/package.json",
        "$TURBO_ROOT$/node_modules/eslint-plugin-import/package.json",
        "$TURBO_ROOT$/node_modules/eslint-plugin-n/package.json",
        "$TURBO_ROOT$/node_modules/eslint-plugin-security/package.json",
        "$TURBO_ROOT$/node_modules/eslint-plugin-sonarjs/package.json",
        "$TURBO_ROOT$/node_modules/eslint-plugin-unicorn/package.json",
        "$TURBO_ROOT$/node_modules/.bun/@typescript-eslint+*/node_modules/@typescript-eslint/*/package.json"
      ],
      "passThroughEnv": ["VAT_BUILT"],
      "outputs": [],
      "cache": true
    },
    // The root's own scripts (`eslint.config.js`, the vitest setup files): no
    // package lints them. Not `//#lint`, which would run the root `lint` script —
    // `turbo run lint` itself. Its inputs are what `eslint . --ignore-pattern
    // 'packages/**'` lints: one glob per place holding such a file, each with a
    // literal prefix so turbo never walks node_modules, .git or another session's
    // worktree (`generate-lint-config.ts --check` derives the places from ESLint
    // and checks them both ways). Plus what `eslint.config.js` reads (every
    // manifest, for the library-rule off-list; the ignore files), the rules and
    // the installed linter.
    "//#lint:root": {
      "inputs": [
        "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "package.json", "packages/*/package.json", ".gitignore", "packages/dev-tools/corpus/compat-empirical/run/.gitignore",
        "packages/utils/eslint/**",
        "node_modules/typescript/package.json",
        "node_modules/eslint/package.json",
        "node_modules/@eslint/js/package.json",
        "node_modules/@eslint-community/eslint-plugin-eslint-comments/package.json",
        "node_modules/@typescript-eslint/eslint-plugin/package.json",
        "node_modules/@typescript-eslint/parser/package.json",
        "node_modules/eslint-plugin-import/package.json",
        "node_modules/eslint-plugin-n/package.json",
        "node_modules/eslint-plugin-security/package.json",
        "node_modules/eslint-plugin-sonarjs/package.json",
        "node_modules/eslint-plugin-unicorn/package.json",
        "$TURBO_ROOT$/node_modules/.bun/@typescript-eslint+*/node_modules/@typescript-eslint/*/package.json"
      ],
      "outputs": [],
      "cache": true
    },
    // `docs/validation-codes.md` is read by unit suites in more than one package
    // (schema's emitted-codes check, agent-skills' doc suite, cli's fs-fault
    // refusals): an edit to it must not replay any package's cached pass. Every
    // per-package `test:unit` override below keeps these inputs as a superset.
    "test:unit": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/validation-codes.md"],
      "outputs": [],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": true,
      // `CI` is hashed HERE and nowhere else, because a CI run and a local run of
      // this task test different things and must not share a cache entry. utils'
      // `realpath-native-folder-mount.integration.test.ts` fails under CI, and
      // skips locally, when the host cannot mount a VHD. dev-tools'
      // `pre-publish-known-defects.integration.test.ts` spawns `pre-publish-check`,
      // which skips its git checks when `CI` is set. The network suites are not
      // the reason: they are system tests gated on `NET_AVAILABLE` (`globalEnv`).
      // Every other task sees `CI` through `globalPassThroughEnv` without it
      // entering the hash — see that key below.
      "env": ["CI"]
    },
    // --- Suites that read committed files OUTSIDE their package ---
    // A task's default inputs are its own package's files, so a suite that reads
    // the repository replays a cached pass over an edit it never saw. Each entry
    // below names what its suite reads; `$TURBO_DEFAULT$` keeps the package's own
    // files. When an integration suite starts reading another tree, add it here.
    //
    // cli: `tagged-report-examples.integration.test.ts` validates every tagged
    // fenced example in every tracked `.md` of the repository. An input glob
    // outside the package is matched on disk, not against git, so the four
    // untracked trees that hold markdown are excluded — they would only churn
    // the hash. Erring wide is safe here (a spare cache miss); erring narrow is
    // the cached pass this entry exists to prevent.
    "@vibe-agent-toolkit/cli#test:integration": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**/*.md",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/.superpowers/**",
        "!$TURBO_ROOT$/.claude/worktrees/**"
      ],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    // lab: `committed-verdict-deltas.integration.test.ts` resolves every
    // `changelog:` reference of the committed deltas file against the changelog,
    // and `vat-lab-cli-dist.integration.test.ts` resolves THIS checkout's built
    // CLI as a `dist:` arm — the same closure edge as the unit task below.
    "@vibe-agent-toolkit/lab#test:integration": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/CHANGELOG.md", "$TURBO_ROOT$/.changes/**"],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    // lab: `instrument.test.ts` resolves THIS checkout's
    // built CLI as a `dist:` arm and digest its whole module closure — the `dist/`
    // of the cli and of every `@vibe-agent-toolkit/*` package it depends on. lab
    // declares only `schema` and `utils`, so `^build` orders neither the cli nor
    // the rest of that closure: a cold run can test before they exist. The cli's
    // own `build` depends on `^build`, so this one edge orders the whole closure,
    // and folds its hash in so a rebuilt closure re-runs the suite. Not a
    // workspace dependency: that would make lab's BUILD wait on the cli too.
    // dev-tools: `turbo-test-concurrency.test.ts` imports EVERY package's
    // integration and system config (and each package's `test:system` script) to
    // check its worker cap, so an edit to one must re-run it rather than replay its
    // cached pass. Scoped here, not in `globalDependencies`, which would make that
    // edit cold for every task. The scan of every package's test tree for reads of
    // built output runs in the integration tier and in validate-structure, not here,
    // so no package's test tree is an input of this task.
    // schema: `emitted-codes-documented.test.ts` collects every `code:` literal
    // under every package's `src/` and requires each in `docs/validation-codes.md`,
    // and the registry ↔ doc suites read that doc too. Without these inputs a new
    // emitted code in another package replayed schema's cached pass locally and
    // was caught only by CI's cold run.
    "@vibe-agent-toolkit/schema#test:unit": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/src/**", "!$TURBO_ROOT$/packages/*/src/vendor/**", "$TURBO_ROOT$/docs/validation-codes.md"],
      "outputs": [],
      "cache": true
    },
    "@vibe-agent-toolkit/dev-tools#test:unit": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/validation-codes.md", "$TURBO_ROOT$/packages/*/vitest.integration.config.ts", "$TURBO_ROOT$/packages/*/vitest.system.config.ts", "$TURBO_ROOT$/packages/*/package.json"],
      "outputs": [],
      "cache": true
    },
    // dev-tools: `built-output-scan.integration.test.ts` is the real-tree control of
    // `checkBuiltOutputEdges`: it scans every package's test tree, `src/` test
    // helpers, scripts and the vitest setup files, so an edit to any of them — or
    // to the turbo config the rule reads beside them — must re-run it rather than
    // replay a cached pass. The entry keeps the generic tier's env, outputs, cache
    // and dependsOn, and its inputs as a superset: the parity check enforces it. The two
    // check-port proofs run this checkout's built `vat` (`check-port-differential.ts`), so the
    // cli build is ordered before it, as the lab's tasks order it.
    "@vibe-agent-toolkit/dev-tools#test:integration": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/test/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "!$TURBO_ROOT$/packages/*/src/vendor/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/turbo.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/vitest.*setup.*"
      ],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    // dev-tools: the repository arms of the check-port proofs
    // (`system/check-ports-repository.system.test.ts`) and of the compiler differential
    // (`system/ts-resolve-repository.system.test.ts`) run this checkout's built `vat` over the
    // whole repository, lint or compile all of it, so the cli build is ordered first and the tree
    // they read is their input, as for the integration tier above.
    "@vibe-agent-toolkit/dev-tools#test:system": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/test/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "!$TURBO_ROOT$/packages/*/src/vendor/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/turbo.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/vitest.*setup.*",
        "$TURBO_ROOT$/vibe-agent-toolkit.config.yaml"
      ],
      "outputs": [],
      "cache": true
    },
    "@vibe-agent-toolkit/lab#test:unit": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/validation-codes.md"],
      "outputs": [],
      "cache": true
    },
    // lab: the system tier times THIS checkout's built CLI as its candidate
    // (`test/system/candidate-subject.ts`, `cli/dist`) — the same closure edge.
    "@vibe-agent-toolkit/lab#test:system": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "outputs": [],
      "cache": true
    },
    "test:system": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": true
    },
    // --- Suites that execute a sibling package's BUILT output ---
    // A test that spawns or imports a package's `dist/` needs the task that produces
    // that output ordered first — and its hash folded in, so a rebuild re-runs the
    // suite. A `workspace:*` devDependency does that through `^build` when it makes
    // no cycle; each entry below would be one (the cli depends on resources and
    // rag-lancedb; lab depends on resources), so the edge is explicit instead.
    // `checkBuiltOutputEdges` (validate-structure) derives every such read from the
    // test files and package scripts, and fails when turbo's own graph orders no task
    // whose declared outputs cover it.
    // A `<pkg>#<task>` entry REPLACES the generic task's settings, it does not merge
    // with them: each copies the generic `dependsOn`, `outputs`, `inputs`, `cache` and
    // `env` — `checkBuiltOutputEdges` fails a `<pkg>#test:<tier>` entry that drops one.
    //
    // rag-lancedb: `cli-dogfooding.system.test.ts` runs `packages/cli/dist/bin.js`.
    "@vibe-agent-toolkit/rag-lancedb#test:system": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "outputs": [],
      "cache": true
    },
    // resources: `external-url-validation.system.test.ts` runs the cli's `dist/bin/vat.js`.
    "@vibe-agent-toolkit/resources#test:system": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "outputs": [],
      "cache": true
    },
    // resources: `git-crawl-io-cost.integration.test.ts` preloads the lab's built I/O
    // counter (`lab/dist/facets/io/counter.cjs`).
    "@vibe-agent-toolkit/resources#test:integration": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/lab#build"],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    // --- Native-memory serialisation ---
    // The root `test:integration` / `test:system` scripts ran turbo with
    // `--concurrency=1` because integration forks in THREE packages hold 1–3 GB of
    // NATIVE memory each (rag: onnxruntime/transformers models; rag-lancedb: the
    // LanceDB Arrow engine; resource-compiler: the TypeScript language service),
    // which `--max-old-space-size` cannot bound and which oversubscribed the host
    // when ~10 packages ran at once (OOM-killed worker, "exit 1, 0 test failures").
    // Serialising the whole tier for three packages made 13 packages' worth of
    // light suites wait in line. These edges chain ONLY the three native-memory
    // packages so no two of them overlap, and the root scripts run the rest at
    // `--concurrency=4`. A task hash folds in its `dependsOn` hashes, so a change
    // to rag's tests re-runs rag-lancedb's — a small, deliberate price for an
    // edge turbo can see. When a package's integration tier starts holding native
    // memory on that scale, add it to this chain. The system tier is not chained:
    // its model holders were measured at under 0.5 GB per process (see
    // `createSystemTestConfig` in vitest.shared.ts) — re-measure if that changes
    // (not enforced, beyond the per-fork RSS detector the system tier carries).
    "@vibe-agent-toolkit/rag-lancedb#test:integration": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/rag#test:integration"],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    "@vibe-agent-toolkit/resource-compiler#test:integration": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/rag-lancedb#test:integration"],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "duplication-check": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    },
    "validate-structure": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    }
  },
  // Root `package.json` is deliberately NOT here. Its dependency surface already
  // reaches every task hash through turbo's lockfile-derived
  // `hashOfExternalDependencies` (see `turbo run <task> --dry=json`), and its
  // other contents — `scripts`, `version`, `engines` — feed no package task. Listing
  // it made every edit to a root script, and every version bump, a fully cold
  // gate for no gain in correctness. (A version bump is STILL cold for every
  // package, because the bump rewrites each package's own manifest, which is an
  // input of that package's tasks; removing the root entry is not what fixes that.)
  "globalDependencies": [
    "tsconfig.json",
    "tsconfig.*.json",
    "eslint.config.js",
    "vitest.config.ts",
    "vitest.*.config.ts",
    "vitest.shared.ts",
    "vitest.setup.js",
    "vitest.fork-rss-budget.setup.js",
    "packages/dev-tools/src/copy-yaml-assets.ts",
    // Loaded by vitest.shared.ts into every tier's reporters: the per-file
    // duration ratchet and its allowlist are inputs of every test task, so an
    // allowlist edit must invalidate them all.
    "packages/dev-tools/src/test-tier-budget-reporter.ts",
    "packages/dev-tools/src/test-tier-budget-allowlist.ts"
  ],
  // `CI` reaches every task (turbo's strict env mode would otherwise strip it)
  // but is hashed only in `test:integration` above. One unit suite also reads
  // it: cli's `absence-causes.test.ts` adds a stricter assertion on Linux under
  // `CI`. CI restores no turbo cache, so that branch always runs there; only a
  // local Linux run can replay one mode's pass for the other.
  // Hashing it globally split every cache entry in two between the pre-commit
  // hook (CI unset) and `bun run validate` (CI=1), so each re-ran the other's
  // build, typecheck and unit tests.
  "globalPassThroughEnv": ["CI"],
  "globalEnv": [
    "NET_AVAILABLE",
    "UPDATE_DRIFT_GOLDEN",
    "VAT_EXTENT_SOURCE",
    "VAT_INVENTORY_CRAWL",
    "VAT_PROJECTION_STORE"
