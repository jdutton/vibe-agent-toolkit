{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "**/*.schema.json", "schemas/**"],
      "cache": true
    },
    // --- Adopter packages ---
    // These packages live in the monorepo but depend on the CLI *binary* at
    // build time (they run `node ../cli/dist/bin/vat.js build` as adopters would).
    // They must NOT be listed as workspace deps of CLI — that creates a cycle.
    // Instead, declare the binary dependency here using package#task syntax so
    // turbo waits for CLI before building each adopter.
    // To register a new adopter package, add a "<pkg>#build" entry below.
    "@vibe-agent-toolkit/vat-development-agents#build": {
      "dependsOn": ["@vibe-agent-toolkit/cli#build", "^build"],
      "outputs": ["dist/**", "agents/**"],
      "cache": true
    },
    "build:skills": {
      "dependsOn": ["build"],
      "outputs": ["dist/skills/**"],
      "cache": true
    },
    // cat-agents runs the CLI *binary* from `build:skills`, not from `build`, so the
    // adopter registration above does not cover it. Without this edge turbo is free to
    // start `node ../cli/dist/bin/vat.js skills build` while a transitive dependency of
    // the CLI is mid-rebuild — and every package here builds via `tsc-clean-build.ts`,
    // which *deletes* `dist/` before emitting. Observed as a hard, repeating failure:
    // gateway-mcp's `dist/` was removed at the instant the CLI tried to import it
    // (`ERR_MODULE_NOT_FOUND` on gateway-mcp/dist/index.js), turbo then killed the
    // gateway build (130) so nothing was cached, and the next run raced identically.
    // Warm caches hid it until a change upstream of gateway-mcp forced a cache miss.
    "@vibe-agent-toolkit/vat-example-cat-agents#build:skills": {
      "dependsOn": ["@vibe-agent-toolkit/cli#build", "build"],
      "outputs": ["dist/skills/**"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "lint": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "test:system": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "duplication-check": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    },
    "validate-structure": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    }
  },
  "globalDependencies": [
    "package.json",
    "tsconfig.json",
    "tsconfig.*.json",
    "eslint.config.js",
    "vitest.config.ts",
    "vitest.*.config.ts",
    "vitest.shared.ts",
    "vitest.setup.js",
    "packages/dev-tools/src/copy-yaml-assets.ts"
  ],
  "globalEnv": ["CI", "NET_AVAILABLE", "UPDATE_DRIFT_GOLDEN"]
}
