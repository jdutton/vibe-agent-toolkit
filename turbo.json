{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    // `*.tsbuildinfo` is a build output and must be cached with `dist/**`, not left
    // behind. Restoring `dist/` without it puts the package in a state TypeScript
    // reads as "never built": the next `tsc` re-emits every file even though the
    // output is already correct, and a `tsc --build` elsewhere in the repo would
    // conclude this project is stale and emit into *this* package's `dist/` from
    // outside turbo's ordering. Both are pure write traffic against a directory
    // other tasks are concurrently reading.
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo", "**/*.schema.json", "schemas/**"],
      "cache": true
    },
    // --- Adopter packages ---
    // These packages live in the monorepo but depend on the CLI *binary* at
    // build time (they run `node ../cli/dist/bin/vat.js build` as adopters would).
    // They must NOT be listed as workspace deps of CLI — that creates a cycle.
    // Instead, declare the binary dependency here using package#task syntax so
    // turbo waits for CLI before building each adopter.
    // A new adopter package needs the same edge on whichever task runs the binary
    // ("<pkg>#build", or "<pkg>#build:skills" below); `checkBuiltOutputEdges`
    // (validate-structure) fails until it is there.
    "@vibe-agent-toolkit/vat-development-agents#build": {
      "dependsOn": ["@vibe-agent-toolkit/cli#build", "^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "build:skills": {
      "dependsOn": ["build"],
      "outputs": ["dist/skills/**"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "lint": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    },
    "test:unit": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": true,
      // `CI` is hashed HERE and nowhere else: two network-dependent integration
      // suites gate on `process.env.CI`, so a CI run and a local run of this
      // task execute different populations and must not share a cache entry.
      // Every other task sees `CI` through `globalPassThroughEnv` without it
      // entering the hash — see that key below.
      "env": ["CI"]
    },
    // --- Suites that read committed files OUTSIDE their package ---
    // A task's default inputs are its own package's files, so a suite that reads
    // the repository replays a cached pass over an edit it never saw. Each entry
    // below names what its suite reads; `$TURBO_DEFAULT$` keeps the package's own
    // files. When an integration suite starts reading another tree, add it here.
    //
    // cli: `tagged-report-examples.integration.test.ts` validates every tagged
    // fenced example in every tracked `.md` of the repository. An input glob
    // outside the package is matched on disk, not against git, so the four
    // untracked trees that hold markdown are excluded — they would only churn
    // the hash. Erring wide is safe here (a spare cache miss); erring narrow is
    // the cached pass this entry exists to prevent.
    "@vibe-agent-toolkit/cli#test:integration": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**/*.md",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/.superpowers/**",
        "!$TURBO_ROOT$/.claude/worktrees/**"
      ],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    // lab: `committed-verdict-deltas.integration.test.ts` resolves every
    // `changelog:` reference of the committed deltas file against the changelog,
    // and `vat-lab-cli-dist.integration.test.ts` resolves THIS checkout's built
    // CLI as a `dist:` arm — the same closure edge as the unit task below.
    "@vibe-agent-toolkit/lab#test:integration": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/CHANGELOG.md", "$TURBO_ROOT$/.changes/**"],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    // lab: `instrument.test.ts` resolves THIS checkout's
    // built CLI as a `dist:` arm and digest its whole module closure — the `dist/`
    // of the cli and of every `@vibe-agent-toolkit/*` package it depends on. lab
    // declares only `schema` and `utils`, so `^build` orders neither the cli nor
    // the rest of that closure: a cold run can test before they exist. The cli's
    // own `build` depends on `^build`, so this one edge orders the whole closure,
    // and folds its hash in so a rebuilt closure re-runs the suite. Not a
    // workspace dependency: that would make lab's BUILD wait on the cli too.
    // dev-tools: `turbo-test-concurrency.test.ts` imports EVERY package's
    // integration and system config (and each package's `test:system` script) to
    // check its worker cap, so an edit to one must re-run it rather than replay its
    // cached pass. Scoped here, not in `globalDependencies`, which would make that
    // edit cold for every task. The scan of every package's test tree for reads of
    // built output runs in the integration tier and in validate-structure, not here,
    // so no package's test tree is an input of this task.
    "@vibe-agent-toolkit/dev-tools#test:unit": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/vitest.integration.config.ts", "$TURBO_ROOT$/packages/*/vitest.system.config.ts", "$TURBO_ROOT$/packages/*/package.json"],
      "outputs": [],
      "cache": true
    },
    // dev-tools: `built-output-scan.integration.test.ts` is the real-tree control of
    // `checkBuiltOutputEdges`: it scans every package's test tree, `src/` test
    // helpers, scripts and the vitest setup files, so an edit to any of them — or
    // to the turbo config the rule reads beside them — must re-run it rather than
    // replay a cached pass. The entry keeps the generic tier's env, outputs, cache
    // and dependsOn, and its inputs as a superset: the parity check enforces it.
    "@vibe-agent-toolkit/dev-tools#test:integration": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/test/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/turbo.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/vitest.*setup.*"
      ],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    "@vibe-agent-toolkit/lab#test:unit": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "outputs": [],
      "cache": true
    },
    // lab: the system tier times THIS checkout's built CLI as its candidate
    // (`test/system/candidate-subject.ts`, `cli/dist`) — the same closure edge.
    "@vibe-agent-toolkit/lab#test:system": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "outputs": [],
      "cache": true
    },
    "test:system": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": true
    },
    // --- Suites that execute a sibling package's BUILT output ---
    // A test that spawns or imports a package's `dist/` needs the task that produces
    // that output ordered first — and its hash folded in, so a rebuild re-runs the
    // suite. A `workspace:*` devDependency does that through `^build` when it makes
    // no cycle; each entry below would be one (the cli depends on resources and
    // rag-lancedb; lab depends on resources), so the edge is explicit instead.
    // `checkBuiltOutputEdges` (validate-structure) derives every such read from the
    // test files and package scripts, and fails when turbo's own graph orders no task
    // whose declared outputs cover it.
    // A `<pkg>#<task>` entry REPLACES the generic task's settings, it does not merge
    // with them: each copies the generic `dependsOn`, `outputs`, `inputs`, `cache` and
    // `env` — `checkBuiltOutputEdges` fails a `<pkg>#test:<tier>` entry that drops one.
    //
    // rag-lancedb: `cli-dogfooding.system.test.ts` runs `packages/cli/dist/bin.js`.
    "@vibe-agent-toolkit/rag-lancedb#test:system": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "outputs": [],
      "cache": true
    },
    // resources: `external-url-validation.system.test.ts` runs the cli's `dist/bin/vat.js`.
    "@vibe-agent-toolkit/resources#test:system": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/cli#build"],
      "outputs": [],
      "cache": true
    },
    // resources: `git-crawl-io-cost.integration.test.ts` preloads the lab's built I/O
    // counter (`lab/dist/facets/io/counter.cjs`).
    "@vibe-agent-toolkit/resources#test:integration": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/lab#build"],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    // --- Native-memory serialisation ---
    // The root `test:integration` / `test:system` scripts ran turbo with
    // `--concurrency=1` because integration forks in THREE packages hold 1–3 GB of
    // NATIVE memory each (rag: onnxruntime/transformers models; rag-lancedb: the
    // LanceDB Arrow engine; resource-compiler: the TypeScript language service),
    // which `--max-old-space-size` cannot bound and which oversubscribed the host
    // when ~10 packages ran at once (OOM-killed worker, "exit 1, 0 test failures").
    // Serialising the whole tier for three packages made 13 packages' worth of
    // light suites wait in line. These edges chain ONLY the three native-memory
    // packages so no two of them overlap, and the root scripts run the rest at
    // `--concurrency=4`. A task hash folds in its `dependsOn` hashes, so a change
    // to rag's tests re-runs rag-lancedb's — a small, deliberate price for an
    // edge turbo can see. When a package's integration tier starts holding native
    // memory on that scale, add it to this chain. The system tier is not chained:
    // its model holders were measured at under 0.5 GB per process (see
    // `createSystemTestConfig` in vitest.shared.ts) — re-measure if that changes
    // (not enforced, beyond the per-fork RSS detector the system tier carries).
    "@vibe-agent-toolkit/rag-lancedb#test:integration": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/rag#test:integration"],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    "@vibe-agent-toolkit/resource-compiler#test:integration": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/rag-lancedb#test:integration"],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "duplication-check": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    },
    "validate-structure": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    }
  },
  // Root `package.json` is deliberately NOT here. Its dependency surface already
  // reaches every task hash through turbo's lockfile-derived
  // `hashOfExternalDependencies` (see `turbo run <task> --dry=json`), and its
  // other contents — `scripts`, `version`, `engines` — feed no package task. Listing
  // it made every edit to a root script, and every version bump, a fully cold
  // gate for no gain in correctness. (A version bump is STILL cold for every
  // package, because the bump rewrites each package's own manifest, which is an
  // input of that package's tasks; removing the root entry is not what fixes that.)
  "globalDependencies": [
    "tsconfig.json",
    "tsconfig.*.json",
    "eslint.config.js",
    "vitest.config.ts",
    "vitest.*.config.ts",
    "vitest.shared.ts",
    "vitest.setup.js",
    "vitest.fork-rss-budget.setup.js",
    "packages/dev-tools/src/copy-yaml-assets.ts",
    // Loaded by vitest.shared.ts into every tier's reporters: the per-file
    // duration ratchet and its allowlist are inputs of every test task, so an
    // allowlist edit must invalidate them all.
    "packages/dev-tools/src/test-tier-budget-reporter.ts",
    "packages/dev-tools/src/test-tier-budget-allowlist.ts"
  ],
  // `CI` reaches every task (turbo's strict env mode would otherwise strip it)
  // but is hashed only where it changes what runs: `test:integration` above.
  // Hashing it globally split every cache entry in two between the pre-commit
  // hook (CI unset) and `bun run validate` (CI=1), so each re-ran the other's
  // build, typecheck and unit tests.
  "globalPassThroughEnv": ["CI"],
  "globalEnv": [
    "NET_AVAILABLE",
    "UPDATE_DRIFT_GOLDEN",
    "VAT_EXTENT_SOURCE",
    "VAT_INVENTORY_CRAWL",
    "VAT_PROJECTION_STORE",
    "VAT_RESOURCES_CRAWL"
  ]
}
