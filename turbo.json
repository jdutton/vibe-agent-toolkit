{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    // `*.tsbuildinfo` is a build output and must be cached with `dist/**`, not left
    // behind. Restoring `dist/` without it puts the package in a state TypeScript
    // reads as "never built": the next `tsc` re-emits every file even though the
    // output is already correct, and a `tsc --build` elsewhere in the repo would
    // conclude this project is stale and emit into *this* package's `dist/` from
    // outside turbo's ordering. Both are pure write traffic against a directory
    // other tasks are concurrently reading.
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo", "**/*.schema.json", "schemas/**"],
      "cache": true
    },
    // --- Adopter packages ---
    // These packages live in the monorepo but depend on the CLI *binary* at
    // build time (they run `node ../cli/dist/bin/vat.js build` as adopters would).
    // They must NOT be listed as workspace deps of CLI — that creates a cycle.
    // Instead, declare the binary dependency here using package#task syntax so
    // turbo waits for CLI before building each adopter.
    // To register a new adopter package, add a "<pkg>#build" entry below.
    // `generated/**` is an output: `build` runs `generate:resources` into it and
    // `src/` imports from it, so a cache hit that restored only `dist/` left
    // `typecheck` (which depends on `^build`, not this package's own `build`)
    // failing on a clean clone or after a clean of ignored files.
    "@vibe-agent-toolkit/vat-development-agents#build": {
      "dependsOn": ["@vibe-agent-toolkit/cli#build", "^build"],
      "outputs": ["dist/**", "*.tsbuildinfo", "agents/**", "generated/**"],
      "cache": true
    },
    "@vibe-agent-toolkit/vat-example-cat-agents#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo", "generated/**"],
      "cache": true
    },
    "build:skills": {
      "dependsOn": ["build"],
      "outputs": ["dist/skills/**"],
      "cache": true
    },
    // cat-agents runs the CLI *binary* from `build:skills`, not from `build`, so the
    // adopter registration above does not cover it. Without this edge turbo is free to
    // start `node ../cli/dist/bin/vat.js skills build` while a transitive dependency of
    // the CLI is mid-rebuild. Observed as a hard, repeating failure: gateway-mcp's
    // `dist/` was removed at the instant the CLI tried to import it
    // (`ERR_MODULE_NOT_FOUND` on gateway-mcp/dist/index.js), turbo then killed the
    // gateway build (130) so nothing was cached, and the next run raced identically.
    // Warm caches hid it until a change upstream of gateway-mcp forced a cache miss.
    //
    // `tsc-clean-build.ts` no longer deletes `dist/` before emitting, so an
    // undeclared edge now degrades to "the reader sees the previous complete build"
    // instead of a crash. That is a safety net, not a substitute: keep declaring the
    // edge. Any task that runs the CLI binary reads a dozen packages' `dist/`, and
    // only an explicit edge makes turbo order them — or rebuild the CLI when they change.
    "@vibe-agent-toolkit/vat-example-cat-agents#build:skills": {
      "dependsOn": ["@vibe-agent-toolkit/cli#build", "build"],
      "outputs": ["dist/skills/**"],
      "cache": true
    },
    // `typecheck` also depends on the package's OWN `build` for the two
    // packages whose `src/` imports generated code; see the adopter entries.
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "@vibe-agent-toolkit/vat-development-agents#typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": true
    },
    "@vibe-agent-toolkit/vat-example-cat-agents#typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": true
    },
    "lint": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    },
    "test:unit": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": true,
      // `CI` is hashed HERE and nowhere else: two network-dependent integration
      // suites gate on `process.env.CI`, so a CI run and a local run of this
      // task execute different populations and must not share a cache entry.
      // Every other task sees `CI` through `globalPassThroughEnv` without it
      // entering the hash — see that key below.
      "env": ["CI"]
    },
    "test:system": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": true
    },
    // --- Native-memory serialisation ---
    // The root `test:integration` / `test:system` scripts ran turbo with
    // `--concurrency=1` because integration forks in THREE packages hold 1–3 GB of
    // NATIVE memory each (rag: onnxruntime/transformers models; rag-lancedb: the
    // LanceDB Arrow engine; resource-compiler: the TypeScript language service),
    // which `--max-old-space-size` cannot bound and which oversubscribed the host
    // when ~10 packages ran at once (OOM-killed worker, "exit 1, 0 test failures").
    // Serialising the whole tier for three packages made 13 packages' worth of
    // light suites wait in line. These edges chain ONLY the three native-memory
    // packages so no two of them overlap, and the root scripts run the rest at
    // `--concurrency=4`. A task hash folds in its `dependsOn` hashes, so a change
    // to rag's tests re-runs rag-lancedb's — a small, deliberate price for an
    // edge turbo can see. When a package starts loading a native model in its
    // integration or system tier, add it to this chain.
    "@vibe-agent-toolkit/rag-lancedb#test:integration": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/rag#test:integration"],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    "@vibe-agent-toolkit/resource-compiler#test:integration": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/rag-lancedb#test:integration"],
      "outputs": [],
      "cache": true,
      "env": ["CI"]
    },
    // `packaged-output-drift.system.test.ts` lives in vat-development-agents but compares
    // TWO packages' `dist/skills` trees against committed goldens — the second is cat-agents,
    // the repo's only multi-file bundle and the only place the link rewriter rewrites a link
    // in a packaged non-SKILL.md file. cat-agents is not a workspace dependency of
    // vat-development-agents, so without this edge the generic `test:system` above gives the
    // gate neither ordering nor invalidation:
    //   - ORDERING: `turbo run test:system` on a clean clone can run the gate before
    //     cat-agents' skills exist. The gate now FAILS on an absent build rather than
    //     skipping, so that would be a spurious red.
    //   - INVALIDATION: a turbo task hash folds in its dependencies' hashes, so this edge is
    //     what makes a change to cat-agents' packaged output re-run the gate. Without it a
    //     rewriter change to cat-agents' bundle replays a cached green from a run that never
    //     saw it — a cached verdict on work it could not have measured.
    "@vibe-agent-toolkit/vat-development-agents#test:system": {
      "dependsOn": ["^build", "build", "@vibe-agent-toolkit/vat-example-cat-agents#build:skills"],
      "outputs": [],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "duplication-check": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    },
    "validate-structure": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    }
  },
  // Root `package.json` is deliberately NOT here. Its dependency surface already
  // reaches every task hash through turbo's lockfile-derived
  // `hashOfExternalDependencies` (see `turbo run <task> --dry=json`), and its
  // other contents — `scripts`, `version`, `engines` — feed no package task. Listing
  // it made every edit to a root script, and every version bump, a fully cold
  // gate for no gain in correctness. (A version bump is STILL cold for every
  // package, because the bump rewrites each package's own manifest, which is an
  // input of that package's tasks; removing the root entry is not what fixes that.)
  "globalDependencies": [
    "tsconfig.json",
    "tsconfig.*.json",
    "eslint.config.js",
    "vitest.config.ts",
    "vitest.*.config.ts",
    "vitest.shared.ts",
    "vitest.setup.js",
    "packages/dev-tools/src/copy-yaml-assets.ts",
    // Loaded by vitest.shared.ts into every tier's reporters: the per-file
    // duration ratchet and its allowlist are inputs of every test task, so an
    // allowlist edit must invalidate them all.
    "packages/dev-tools/src/test-tier-budget-reporter.ts",
    "packages/dev-tools/src/test-tier-budget-allowlist.ts"
  ],
  // `CI` reaches every task (turbo's strict env mode would otherwise strip it)
  // but is hashed only where it changes what runs: `test:integration` above.
  // Hashing it globally split every cache entry in two between the pre-commit
  // hook (CI unset) and `bun run validate` (CI=1), so each re-ran the other's
  // build, typecheck and unit tests.
  "globalPassThroughEnv": ["CI"],
  "globalEnv": [
    "NET_AVAILABLE",
    "UPDATE_DRIFT_GOLDEN",
    "VAT_EXTENT_SOURCE",
    "VAT_INVENTORY_CRAWL",
    "VAT_PROJECTION_STORE",
    "VAT_RESOURCES_CRAWL"
  ]
}
